{
  "info": {
    "_postman_id": "7b8f9e12-3456-4abc-9def-1234567890ab",
    "name": "API Catálogo de Productos",
    "description": "Colección de pruebas de integración E2E automatizadas para la API de Catálogo de Productos (Unidad 10).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "productoId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Crear producto válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Propiedad id es numérica y se guarda en variable de colección\", function () {",
              "    const b = pm.response.json();",
              "    pm.expect(b).to.have.property(\"id\");",
              "    pm.expect(b.id).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"productoId\", b.id);",
              "});",
              "",
              "pm.test(\"Tiempo de respuesta es menor a 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"precio\": 120.0,\n  \"categoria\": \"ELECTRONICA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Obtener producto creado por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Nombre coincide con 'Teclado mecánico'\", function () {",
              "    const b = pm.response.json();",
              "    pm.expect(b.nombre).to.eql(\"Teclado mecánico\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Listar productos por categoría ELECTRONICA",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Retorna array no vacío\", function () {",
              "    const b = pm.response.json();",
              "    pm.expect(Array.isArray(b)).to.be.true;",
              "    pm.expect(b.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos?categoria=ELECTRONICA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ],
          "query": [
            {
              "key": "categoria",
              "value": "ELECTRONICA"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Consultar producto inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "99999"
          ]
        }
      },
      "response": []
    }
  ]
}

